# Normalise to LF in the repository. Without this, committing from Windows
# stores CRLF and every Linux CI checkout shows the whole tree as modified.
* text=auto eol=lf

# Shell scripts and container entrypoints must keep LF even when checked out
# on Windows — a CRLF shebang line makes the kernel fail with "bad interpreter".
*.sh text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary

# Generated — collapse in diffs and exclude from language statistics.
pnpm-lock.yaml linguist-generated=true -diff
packages/database/prisma/migrations/** linguist-generated=true
