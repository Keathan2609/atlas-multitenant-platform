# ─────────────────────────────────────────────────────────────────────────────
# ATLAS environment contract
#
# Copy to .env for local development:   cp .env.example .env
# Every variable here is validated at startup by packages/config env schemas.
# The API refuses to boot if a required variable is missing or malformed —
# failing at boot is preferable to failing on the first request that needs it.
#
# The values below are LOCAL DEVELOPMENT DEFAULTS ONLY. They are intentionally
# committed so `docker compose up` works on a fresh clone. Never reuse them
# outside a local machine.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Datastores ───────────────────────────────────────────────────────────────
# Matches infrastructure/docker-compose.yml. Port 5434 avoids colliding with a
# Postgres already listening on the host default 5432.
DATABASE_URL=postgresql://atlas:atlas_local_dev@localhost:5434/atlas?schema=public

# Separate database used by the integration test suite so a test run never
# truncates your development data.
TEST_DATABASE_URL=postgresql://atlas:atlas_local_dev@localhost:5434/atlas_test?schema=public

REDIS_URL=redis://localhost:6380

# ── API ──────────────────────────────────────────────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0

# Reverse-proxy hops in front of the API. 0 = reached directly, so
# X-Forwarded-For is ignored. Set this to the real hop count when deploying
# behind a load balancer, and never higher: req.ip is the login rate-limit
# bucket key and the address recorded on sessions and audit entries, so an
# over-trusting value lets a client forge both.
TRUST_PROXY=0

# Comma-separated list of origins permitted to send credentialed requests.
CORS_ORIGINS=http://localhost:3000

# ── Session & crypto ─────────────────────────────────────────────────────────
# Signs the session cookie, so a tampered or fabricated one is rejected before
# any datastore lookup. MUST be >= 32 chars. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev_only_session_secret_change_me_0123456789abcdef

# Sliding session lifetime, in seconds. 7 days.
SESSION_TTL_SECONDS=604800

# Pepper mixed into API key hashing, in addition to the per-key salt.
# Rotating this invalidates every existing API key.
API_KEY_PEPPER=dev_only_api_key_pepper_change_me_0123456789abcd

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=300
RATE_LIMIT_API_MAX=120
RATE_LIMIT_API_WINDOW_SECONDS=60

# ── Email ────────────────────────────────────────────────────────────────────
# `smtp` sends through the local Mailpit container (see docker-compose).
# `console` writes rendered messages to the log instead. `noop` discards them.
EMAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM="ATLAS <no-reply@atlas.local>"

# Base URL used to build invitation links in outbound email.
APP_BASE_URL=http://localhost:3000

# ── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=debug
# `pretty` for human-readable local logs, `json` for production ingestion.
LOG_FORMAT=pretty

# ── Web ──────────────────────────────────────────────────────────────────────
# Browser-visible. Must be reachable from the user's browser, not just the container.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Server-side calls from Next.js to the API. Inside Docker this becomes http://api:4000.
API_INTERNAL_URL=http://localhost:4000
